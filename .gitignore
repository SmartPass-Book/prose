# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Tauri mobile. The Xcode project itself is generated by `tauri ios init` and
# is checked in so CI and a fresh clone don't have to regenerate it, but the
# build outputs and the Rust staticlibs it links are not.
src-tauri/gen/apple/build/
src-tauri/gen/apple/Externals/
src-tauri/gen/apple/Pods/
src-tauri/gen/apple/*.xcodeproj/project.xcworkspace/xcuserdata/
src-tauri/gen/apple/*.xcodeproj/xcuserdata/
src-tauri/gen/schemas/
